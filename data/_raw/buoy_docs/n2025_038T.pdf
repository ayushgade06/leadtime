            font-size: 5.5rem;
            font-weight: 800;
            color: var(--nho-navy-primary);
            margin: 0 0 1.5rem;
            line-height: 1;
        }

        .nho-404-heading span {
            color: var(--nho-error);
        }

        .nho-404-description {
            font-size: 1.5rem;
            color: var(--nho-navy-primary);
            margin: 0 auto 4rem;
            max-width: 640px;
            line-height: 1.6;
            font-weight: 400;
        }

        .nho-404-buttons {
            display: flex;
            gap: 2rem;
            justify-content: center;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .nho-404-button {
            padding: 1.25rem 3rem;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            font-size: 1.125rem;
            letter-spacing: 0.5px;
            min-width: 240px;
            text-align: center;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
        }

        .nho-404-button-solid {
            background: var(--nho-navy-primary);
            color: var(--nho-white);
        }

        .nho-404-button-solid:hover {
            background: var(--nho-navy-dark);
