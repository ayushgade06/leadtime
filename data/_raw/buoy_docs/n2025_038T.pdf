            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 46, 93, 0.2);
        }

        .nho-404-button-outline {
            background: transparent;
            color: var(--nho-navy-primary);
            border: 2px solid var(--nho-navy-primary);
        }

        .nho-404-button-outline:hover {
            background: rgba(0, 46, 93, 0.05);
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 46, 93, 0.1);
        }

        /* Footer */
        .nho-404-page-footer {
            padding: 3rem;
            text-align: center;
            font-size: 1rem;
            color: var(--nho-navy-light);
            font-weight: 500;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border-top: 1px solid var(--nho-border);
        }

        /* Navy stripe accent */
        .nho-404-accent-line {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, 
